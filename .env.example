JWT_SECRET=replace-with-a-long-random-secret

# WebAuthn relying party config. Optional locally (falls back to the request's
# hostname/origin — see lib/webauthn.ts), but should be set explicitly in
# production to your real domain, e.g.:
#   RP_ID=your-app.up.railway.app
#   ORIGIN=https://your-app.up.railway.app
RP_ID=
ORIGIN=

# Set automatically by Railway when a volume is attached; used by lib/db.ts
# to persist todos.db outside the container filesystem across deploys.
# Not needed for local development.
RAILWAY_VOLUME_MOUNT_PATH=
